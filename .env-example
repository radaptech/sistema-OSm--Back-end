DB_SERVER=postgres
DB_USER=postgres
DB_PORT=5432
DATABASE=sistema-OS
DB_PASSWORD=postgres



R2_IDCLOUDFLARE=
R2_KEYID=
R2_SECRETKEY=
R2_BUCKET_NAME_MAQUINARIO=
R2_BUCKET_NAME_PEQUENOS_REPAROS=
R2_BUCKET_NAME_OS_SERVICO=
# Foto de cadastro de loja, setor e empresa terceirizada (um bucket cada). Vazio
# só quebra o upload; o resto do CRUD segue.
R2_BUCKET_NAME_IMG_LOJAS=
R2_BUCKET_NAME_IMG_SETORES=
R2_BUCKET_NAME_IMG_TERCERIZADOS=

# Web Push (notificação no celular/desktop, PWA). Gere o par com `make chaves-vapid`,
# UMA vez por ambiente: trocar invalida a inscrição de todo aparelho. Sem as duas
# chaves o push fica desligado e a notificação só aparece no sininho.
# VAPID_SUBJECT é o contato que vai na assinatura (e-mail ou URL https).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=contato@radaptech.com.br
# Recuperação de senha por e-mail (Resend). URL_FRONTEND_FORMATO leva um %s onde
# entra o subdomínio do tenant -- em produção, https://%s.radaptech.com.br.
RESEND_API_KEY=
URL_FRONTEND_FORMATO=http://%s.localhost:8090
